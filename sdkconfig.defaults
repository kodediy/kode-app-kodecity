# Neon Bay's settings. Everything about the board arrives from kbsp's
# sdkconfig.board, which CMakeLists.txt fetches and reads first.

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="managed_components/kodediy__kbsp/partitions.csv"
CONFIG_KODEOS_BOOT_ROLE_APP=y

# The bench: the console's variables and functions, and screenshots.
CONFIG_KODEOS_CONSOLE=y

# The game draws with the pixel accelerator (kscreen_pic_*).
CONFIG_KODE_COMPOSE=y

# No radio: the game is offline (the board already keeps esp-hosted off).
CONFIG_KODEOS_RADIO=n
CONFIG_BT_ENABLED=n

# Screenshots for the catalog (kcli.py screenshot) and the bench.
CONFIG_KODEOS_SCREENSHOT=y
